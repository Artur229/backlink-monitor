{
  "name": "backlink-monitor",
  "version": "1.0.0",
  "description": "Daily monitor for purchased backlinks with Telegram alerts",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "import": "tsx src/cli/import.ts",
    "test:watch": "vitest",
    "check": "tsx src/cli/check.ts",
    "worker": "tsx src/worker/index.ts",
    "run-now": "tsx src/cli/run-now.ts",
    "queue:status": "tsx src/cli/queue-status.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "^6.7.3",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "ioredis": "^6.0.0",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
